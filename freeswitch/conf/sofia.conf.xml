<?xml version="1.0" encoding="utf-8"?>
<configuration name="sofia.conf" description="Sofia Configuration">
  <profiles>
    <profile name="default">
      <settings>
        <param name="debug" value="0"/>
        <param name="sip-trace" value="no"/>
        <param name="sip-capture" value="no"/>
        <param name="rfc2833-pt" value="101"/>
        <param name="sip-port" value="5060"/>
        <param name="dialplan" value="XML"/>
        <param name="context" value="default"/>
        <param name="dtmf-type" value="rfc2833"/>
        <param name="inbound-codec-prefs" value="PCMU,PCMA,GSM"/>
        <param name="outbound-codec-prefs" value="PCMU,PCMA,GSM"/>
        <param name="rtp-ip" value="auto"/>
        <param name="sip-ip" value="auto"/>
        <param name="rtp-timeout-sec" value="300"/>
        <param name="rtp-hold-timeout-sec" value="1800"/>
        <param name="rtp-timer-name" value="soft"/>
        <param name="rtp-ptime" value="20"/>
        <param name="rtp-ignore-ssrc" value="true"/>
        <param name="sip-timer-name" value="soft"/>
        <param name="sip-timer-min-se" value="60"/>
        <param name="sip-timer-se" value="7200"/>
        <param name="log-auth-failures" value="true"/>
        <param name="log-level" value="info"/>
        <param name="auto-create-sip-profiles" value="true"/>
      </settings>
    </profile>
  </profiles>
</configuration>