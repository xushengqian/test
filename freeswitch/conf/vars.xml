<?xml version="1.0" encoding="utf-8"?>
<include>
  <!-- 基本变量配置 -->
  <X-PRE-PROCESS cmd="set" data="default_password=1234"/>
  <X-PRE-PROCESS cmd="set" data="domain=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="domain_name=$${domain}"/>
  <X-PRE-PROCESS cmd="set" data="hold_music=local_stream://moh"/>
  
  <!-- 外呼相关配置 -->
  <X-PRE-PROCESS cmd="set" data="outbound_caller_id_name=Robot Caller"/>
  <X-PRE-PROCESS cmd="set" data="outbound_caller_id_number=10086"/>
  
  <!-- 录音配置 -->
  <X-PRE-PROCESS cmd="set" data="recordings_dir=$${base_dir}/recordings"/>
  <X-PRE-PROCESS cmd="set" data="record_path=$${recordings_dir}"/>
  
  <!-- 机器人配置 -->
  <X-PRE-PROCESS cmd="set" data="robot_timeout=30"/>
  <X-PRE-PROCESS cmd="set" data="human_queue=human_agents"/>
  
  <!-- 外部服务配置 -->
  <X-PRE-PROCESS cmd="set" data="api_server=http://localhost:8000"/>
  <X-PRE-PROCESS cmd="set" data="tts_server=http://localhost:8001"/>
  <X-PRE-PROCESS cmd="set" data="asr_server=http://localhost:8002"/>
</include>