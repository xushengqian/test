# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=metric_scheduler

# Redis配置（用于分布式锁）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 调度器配置
MAX_CONCURRENT_JOBS=10
JOB_SCAN_INTERVAL=5
JOB_TIMEOUT_CHECK_INTERVAL=60
DEFAULT_JOB_TIMEOUT=3600
MAX_RETRY_TIMES=3
RETRY_INTERVAL=300

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/metric_scheduler.log