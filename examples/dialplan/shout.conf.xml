<!--
    FreeSWITCH mod_shout 配置文件
    
    位置：/etc/freeswitch/autoload_configs/shout.conf.xml
    
    功能：配置 MP3 播放和 Shoutcast/Icecast 流支持
    
    使用方法：
    1. 确保已安装 mod_shout 模块
    2. 将此文件放到 /etc/freeswitch/autoload_configs/ 目录
    3. 在 modules.conf.xml 中启用模块：<load module="mod_shout"/>
    4. 重启 FreeSWITCH 或执行：load mod_shout
    
    注意：mod_shout 依赖 libshout 和 libmpg123 库
-->

<configuration name="shout.conf" description="Shout Configuration">
    <settings>
        
        <!-- ============================================ -->
        <!-- 解码器设置 -->
        <!-- ============================================ -->
        
        <!-- 解码器缓冲区大小（毫秒） -->
        <!-- 增大此值可提高稳定性，但会增加延迟 -->
        <!-- 减小此值可降低延迟，但可能导致音频断续 -->
        <!-- 推荐范围：100-500 -->
        <param name="decoder-buffer" value="200"/>
        
        <!-- 采样率转换质量 -->
        <!-- 0 = 最快（质量最低） -->
        <!-- 4 = 最慢（质量最高） -->
        <!-- 推荐值：2（平衡质量和性能） -->
        <param name="resample-quality" value="2"/>
        
        <!-- ============================================ -->
        <!-- 音频设置 -->
        <!-- ============================================ -->
        
        <!-- 音量调整 -->
        <!-- 1.0 = 原始音量 -->
        <!-- 0.5 = 减小一半 -->
        <!-- 2.0 = 加倍（可能导致失真） -->
        <param name="volume" value="1.0"/>
        
        <!-- 声道数 -->
        <!-- 1 = 单声道 -->
        <!-- 2 = 立体声 -->
        <!-- 通常电话系统使用单声道 -->
        <param name="channels" value="1"/>
        
        <!-- 采样率 -->
        <!-- 8000 = 8kHz（标准电话质量） -->
        <!-- 16000 = 16kHz（宽带语音） -->
        <!-- <param name="samplerate" value="8000"/> -->
        
        <!-- ============================================ -->
        <!-- 网络设置 -->
        <!-- ============================================ -->
        
        <!-- HTTP 超时时间（秒） -->
        <!-- 连接 HTTP 服务器的最大等待时间 -->
        <param name="timeout" value="30"/>
        
        <!-- 重试次数 -->
        <!-- 连接失败时的重试次数 -->
        <param name="retries" value="3"/>
        
        <!-- 用户代理 -->
        <!-- 发送给 HTTP 服务器的 User-Agent 头 -->
        <param name="user-agent" value="FreeSWITCH/mod_shout"/>
        
        <!-- ============================================ -->
        <!-- Shoutcast/Icecast 流设置 -->
        <!-- ============================================ -->
        
        <!-- 流缓冲区大小（字节） -->
        <!-- 用于 Shoutcast/Icecast 流的缓冲区 -->
        <!-- 增大可提高稳定性，但会增加延迟 -->
        <param name="stream-buffer-size" value="65536"/>
        
        <!-- 元数据更新间隔（秒） -->
        <!-- 从流中获取元数据的间隔 -->
        <param name="metadata-interval" value="10"/>
        
        <!-- ============================================ -->
        <!-- 编码设置（用于录音） -->
        <!-- ============================================ -->
        
        <!-- MP3 比特率 -->
        <!-- 录音时的 MP3 比特率（kbps） -->
        <!-- 常用值：64, 96, 128, 192, 256, 320 -->
        <param name="encode-bitrate" value="128"/>
        
        <!-- MP3 质量 -->
        <!-- 0 = 最高质量 -->
        <!-- 9 = 最低质量 -->
        <param name="encode-quality" value="2"/>
        
    </settings>
</configuration>
