<!--
    FreeSWITCH Dialplan 配置：HTTP 音频播放示例
    
    将此文件放到 /etc/freeswitch/dialplan/default/ 目录
    然后执行 reloadxml 重新加载配置
    
    使用方法：
    1. 拨打 8001 - 播放 HTTP MP3 音频
    2. 拨打 8002 - 播放缓存的 HTTP WAV 音频
    3. 拨打 8003 - 播放动态 TTS 音频
    4. 拨打 8004 - IVR 菜单示例
    5. 拨打 8005 - 使用 Lua 脚本播放
-->

<include>
    
    <!-- ============================================ -->
    <!-- 示例 1：播放 HTTP MP3 音频（使用 mod_shout） -->
    <!-- ============================================ -->
    <extension name="play_http_mp3">
        <condition field="destination_number" expression="^8001$">
            <!-- 接听电话 -->
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 记录日志 -->
            <action application="log" data="INFO Playing HTTP MP3 audio"/>
            
            <!-- 播放 HTTP MP3 文件（使用 shout 协议） -->
            <action application="playback" data="shout://audio.example.com/welcome.mp3"/>
            
            <!-- 播放完成后挂断 -->
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 2：播放缓存的 HTTP WAV 音频 -->
    <!-- ============================================ -->
    <extension name="play_cached_http_audio">
        <condition field="destination_number" expression="^8002$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <action application="log" data="INFO Playing cached HTTP WAV audio"/>
            
            <!-- 使用 http_cache 协议（先下载缓存，再播放） -->
            <action application="playback" data="http_cache://http://audio.example.com/message.wav"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 3：播放动态 TTS 音频 -->
    <!-- ============================================ -->
    <extension name="play_dynamic_tts">
        <condition field="destination_number" expression="^8003$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 设置 TTS 文本（URL 编码） -->
            <action application="set" data="tts_text=%E6%82%A8%E5%A5%BD%EF%BC%8C%E6%AC%A2%E8%BF%8E%E8%87%B4%E7%94%B5"/>
            
            <!-- 从 TTS 服务获取动态音频 -->
            <action application="set" data="tts_url=http://tts.example.com/api/speak?text=${tts_text}&amp;format=mp3"/>
            
            <action application="log" data="INFO Playing TTS audio: ${tts_url}"/>
            
            <!-- 播放 TTS 音频 -->
            <action application="playback" data="shout://${tts_url}"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 4：IVR 菜单（带 HTTP 音频） -->
    <!-- ============================================ -->
    <extension name="ivr_with_http_audio">
        <condition field="destination_number" expression="^8004$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 设置 DTMF 终止符 -->
            <action application="set" data="playback_terminators=#"/>
            
            <!-- 设置最大等待时间 -->
            <action application="set" data="read_timeout=5000"/>
            
            <!-- 播放菜单并等待输入 -->
            <action application="play_and_get_digits" data="1 1 3 5000 # shout://audio.example.com/ivr/main_menu.mp3 shout://audio.example.com/ivr/invalid.mp3 menu_choice \d"/>
            
            <!-- 根据用户选择执行不同操作 -->
            <action application="log" data="INFO User selected: ${menu_choice}"/>
            
            <!-- 选项 1：查询余额 -->
            <action application="execute_extension" data="ivr_option_${menu_choice}" inline="true"/>
        </condition>
    </extension>
    
    <!-- IVR 选项 1 -->
    <extension name="ivr_option_1">
        <condition field="destination_number" expression="^ivr_option_1$">
            <action application="log" data="INFO User selected option 1"/>
            <action application="playback" data="shout://audio.example.com/ivr/balance_info.mp3"/>
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- IVR 选项 2 -->
    <extension name="ivr_option_2">
        <condition field="destination_number" expression="^ivr_option_2$">
            <action application="log" data="INFO User selected option 2 - transfer to agent"/>
            <action application="playback" data="shout://audio.example.com/ivr/transferring.mp3"/>
            <!-- 转接到坐席 -->
            <action application="transfer" data="operator XML default"/>
        </condition>
    </extension>
    
    <!-- IVR 无效选择 -->
    <extension name="ivr_option_">
        <condition field="destination_number" expression="^ivr_option_$">
            <action application="playback" data="shout://audio.example.com/ivr/invalid.mp3"/>
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 5：使用 Lua 脚本播放 HTTP 音频 -->
    <!-- ============================================ -->
    <extension name="lua_http_audio">
        <condition field="destination_number" expression="^8005$">
            <!-- 设置音频 URL（可从数据库或 API 获取） -->
            <action application="set" data="audio_url=http://audio.example.com/custom/${caller_id_number}.mp3"/>
            
            <!-- 执行 Lua 脚本 -->
            <action application="lua" data="play_http_audio.lua"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 6：动态变量播放 -->
    <!-- ============================================ -->
    <extension name="dynamic_audio_by_caller">
        <condition field="destination_number" expression="^800(\d+)$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 从正则匹配获取音频 ID -->
            <action application="set" data="audio_id=$1"/>
            
            <!-- 构建动态 URL -->
            <action application="set" data="audio_url=http://api.example.com/audio/${audio_id}"/>
            
            <action application="log" data="INFO Playing audio: ${audio_url}"/>
            
            <!-- 播放（根据格式选择协议） -->
            <action application="playback" data="shout://${audio_url}"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 7：带 HTTP 音频的验证码播放 -->
    <!-- ============================================ -->
    <extension name="verification_code_playback">
        <condition field="destination_number" expression="^8006$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 从通道变量获取验证码（外部系统设置） -->
            <!-- 如果没有设置，使用默认值 -->
            <action application="set" data="code=${verification_code:-123456}"/>
            
            <!-- 使用 TTS 服务播放验证码 -->
            <action application="set" data="tts_url=http://tts.example.com/api/speak?text=您的验证码是${code}"/>
            
            <!-- 播放两遍 -->
            <action application="playback" data="shout://${tts_url}"/>
            <action application="sleep" data="1000"/>
            <action application="playback" data="shout://${tts_url}"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 8：播放 HTTPS 音频 -->
    <!-- ============================================ -->
    <extension name="play_https_audio">
        <condition field="destination_number" expression="^8007$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- HTTPS 音频（需要正确配置 SSL 证书） -->
            <action application="playback" data="http_cache://https://secure.example.com/audio/message.wav"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 9：音频列表顺序播放 -->
    <!-- ============================================ -->
    <extension name="play_audio_sequence">
        <condition field="destination_number" expression="^8008$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 按顺序播放多个音频 -->
            <action application="playback" data="shout://audio.example.com/sequence/intro.mp3"/>
            <action application="sleep" data="300"/>
            <action application="playback" data="shout://audio.example.com/sequence/content.mp3"/>
            <action application="sleep" data="300"/>
            <action application="playback" data="shout://audio.example.com/sequence/outro.mp3"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 10：带超时和重试的播放 -->
    <!-- ============================================ -->
    <extension name="play_with_retry">
        <condition field="destination_number" expression="^8009$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 设置超时时间 -->
            <action application="set" data="http_cache_timeout=30"/>
            
            <!-- 尝试播放主音频 -->
            <action application="playback" data="shout://audio.example.com/main.mp3"/>
            
            <!-- 检查播放是否成功 -->
            <action application="log" data="INFO Playback status: ${playback_last_result}"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
    <!-- ============================================ -->
    <!-- 示例 11：MOH（等待音乐）使用 HTTP 流 -->
    <!-- ============================================ -->
    <extension name="moh_http_stream">
        <condition field="destination_number" expression="^8010$">
            <action application="answer"/>
            <action application="sleep" data="500"/>
            
            <!-- 播放 Shoutcast/Icecast 流作为等待音乐 -->
            <!-- 这会一直播放直到通道被中断 -->
            <action application="playback" data="shout://streaming.example.com:8000/live"/>
            
            <action application="hangup"/>
        </condition>
    </extension>
    
</include>
