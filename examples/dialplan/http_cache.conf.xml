<!--
    FreeSWITCH mod_http_cache 配置文件
    
    位置：/etc/freeswitch/autoload_configs/http_cache.conf.xml
    
    功能：配置 HTTP 文件缓存，用于从 HTTP 服务器下载音频文件并缓存到本地
    
    使用方法：
    1. 将此文件放到 /etc/freeswitch/autoload_configs/ 目录
    2. 在 modules.conf.xml 中启用模块：<load module="mod_http_cache"/>
    3. 重启 FreeSWITCH 或执行：load mod_http_cache
-->

<configuration name="http_cache.conf" description="HTTP Cache Configuration">
    <settings>
        <!-- 缓存目录 -->
        <!-- 确保 FreeSWITCH 进程对此目录有读写权限 -->
        <param name="location" value="/var/cache/freeswitch/http_cache"/>
        
        <!-- 默认缓存时间（秒） -->
        <!-- 0 表示永不过期，文件将一直缓存直到手动清理 -->
        <!-- 建议设置合理的过期时间以避免磁盘空间耗尽 -->
        <param name="default-cache-time" value="86400"/>
        
        <!-- 最大缓存大小（MB） -->
        <!-- 当缓存达到此大小时，旧文件会被自动清理 -->
        <param name="max-size" value="1000"/>
        
        <!-- HTTP 连接超时（秒） -->
        <!-- 建立 HTTP 连接的最大等待时间 -->
        <param name="connect-timeout" value="10"/>
        
        <!-- HTTP 读取超时（秒） -->
        <!-- 读取 HTTP 响应的最大等待时间 -->
        <param name="read-timeout" value="30"/>
        
        <!-- 预取线程数 -->
        <!-- 用于后台下载文件的线程数 -->
        <param name="prefetch-thread-count" value="4"/>
        
        <!-- 预取队列大小 -->
        <param name="prefetch-queue-size" value="100"/>
        
        <!-- SSL 证书验证 -->
        <!-- 生产环境建议设置为 true -->
        <param name="ssl-verify-peer" value="true"/>
        
        <!-- SSL CA 证书路径 -->
        <!-- 用于验证 HTTPS 服务器证书 -->
        <param name="ssl-ca-info" value="/etc/ssl/certs/ca-certificates.crt"/>
        
        <!-- SSL 版本 -->
        <!-- 可选值：sslv3, tlsv1, tlsv1.1, tlsv1.2, tlsv1.3 -->
        <!-- <param name="ssl-version" value="tlsv1.2"/> -->
        
        <!-- 代理设置（可选） -->
        <!-- 如果需要通过代理访问 HTTP 服务器 -->
        <!-- <param name="proxy" value="http://proxy.example.com:8080"/> -->
        
        <!-- 启用文件锁定 -->
        <!-- 防止多个进程同时写入同一文件 -->
        <param name="file-locking" value="true"/>
    </settings>
    
    <!-- 配置多个 HTTP 源/配置文件 -->
    <profiles>
        
        <!-- 默认配置文件 -->
        <profile name="default">
            <!-- 域名匹配 -->
            <param name="domain" value="*"/>
        </profile>
        
        <!-- 音频服务器配置 -->
        <profile name="audio-server">
            <param name="domain" value="audio.example.com"/>
            
            <!-- 此域名的特定缓存时间 -->
            <param name="cache-time" value="3600"/>
            
            <!-- HTTP Basic 认证（可选） -->
            <!-- <param name="username" value="user"/> -->
            <!-- <param name="password" value="pass"/> -->
        </profile>
        
        <!-- TTS 服务器配置 -->
        <profile name="tts-server">
            <param name="domain" value="tts.example.com"/>
            
            <!-- TTS 音频通常不需要长时间缓存 -->
            <param name="cache-time" value="60"/>
            
            <!-- 禁用缓存（每次都重新获取） -->
            <!-- <param name="cache-time" value="0"/> -->
        </profile>
        
        <!-- AWS S3 配置 -->
        <profile name="aws-s3">
            <param name="domain" value="s3.amazonaws.com"/>
            
            <!-- AWS S3 认证 -->
            <param name="aws-s3-access-key-id" value="YOUR_ACCESS_KEY"/>
            <param name="aws-s3-secret-access-key" value="YOUR_SECRET_KEY"/>
            
            <!-- 可选：指定 AWS 区域 -->
            <!-- <param name="aws-s3-region" value="us-east-1"/> -->
        </profile>
        
        <!-- 阿里云 OSS 配置（通过签名 URL 访问） -->
        <profile name="aliyun-oss">
            <param name="domain" value="oss-cn-hangzhou.aliyuncs.com"/>
            <param name="cache-time" value="3600"/>
        </profile>
        
        <!-- 内部音频服务器（不验证 SSL） -->
        <profile name="internal-audio">
            <param name="domain" value="internal-audio.local"/>
            <param name="ssl-verify-peer" value="false"/>
        </profile>
        
    </profiles>
    
</configuration>
