# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=metric_scheduler
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=40
MYSQL_POOL_RECYCLE=3600

# Redis配置（可选，用于分布式部署）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 并行调度器配置
# 作业扫描间隔（秒）
JOB_SCAN_INTERVAL=30
# 并行扫描工作线程数
JOB_SCAN_WORKERS=4
# 最大并发作业数
MAX_CONCURRENT_JOBS=50
# 执行器工作线程数
EXECUTOR_WORKERS=20
# 批量处理大小
BATCH_SIZE=100
# 批量创建作业的并行度
BATCH_CREATE_WORKERS=5

# 超时和重试配置
JOB_TIMEOUT_CHECK_INTERVAL=60
DEFAULT_JOB_TIMEOUT=3600
MAX_RETRY_TIMES=3
RETRY_INTERVAL=300

# 分布式锁配置
LOCK_TIMEOUT=300
LOCK_RETRY_TIMES=3

# 性能监控配置
ENABLE_METRICS=true
METRICS_INTERVAL=60

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/parallel_scheduler.log
