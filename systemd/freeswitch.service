[Unit]
Description=FreeSWITCH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freeswitch
Group=freeswitch

# 默认按源码安装路径；可由 /etc/default/freeswitch 覆盖
Environment=FS_HOME=/usr/local/freeswitch
EnvironmentFile=-/etc/default/freeswitch

WorkingDirectory=${FS_HOME}
ExecStart=${FS_HOME}/bin/freeswitch -nc -nonat
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=100000
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
