# FS机器人外呼系统环境配置示例

# ===================
# 数据库配置
# ===================
POSTGRES_DB=robot_call_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
DATABASE_URL=postgresql://postgres:password123@postgres:5432/robot_call_db

# ===================
# Redis配置
# ===================
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ===================
# FreeSwitch配置
# ===================
FREESWITCH_HOST=freeswitch
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon

# ===================
# 后端服务配置
# ===================
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secret-key-change-in-production-environment

# ===================
# 外呼配置
# ===================
OUTBOUND_GATEWAY=outbound
OUTBOUND_CALLER_ID_NAME=Robot Caller
OUTBOUND_CALLER_ID_NUMBER=10086
MAX_CONCURRENT_CALLS=100
CALL_TIMEOUT=60

# ===================
# SIP网关配置（需要根据实际运营商配置）
# ===================
SIP_USERNAME=your_sip_username
SIP_PASSWORD=your_sip_password
SIP_REALM=your_sip_provider.com
SIP_PROXY=your_sip_provider.com

# ===================
# AI服务配置（可选）
# ===================
# OpenAI配置
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Azure语音服务配置
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# ===================
# 语音服务配置
# ===================
TTS_SERVICE_URL=http://localhost:8001
ASR_SERVICE_URL=http://localhost:8002

# ===================
# 文件存储配置
# ===================
RECORDINGS_DIR=/var/lib/freeswitch/recordings
TEMP_DIR=/tmp

# ===================
# 队列配置
# ===================
HUMAN_QUEUE_NAME=human_agents
MAX_QUEUE_SIZE=50
QUEUE_TIMEOUT=300

# ===================
# 监控配置
# ===================
METRICS_ENABLED=true
LOG_LEVEL=INFO

# ===================
# 安全配置
# ===================
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_HOSTS=localhost,127.0.0.1

# ===================
# 邮件配置（可选）
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true

# ===================
# 短信配置（可选）
# ===================
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret