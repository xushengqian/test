# 环境配置示例文件
# 复制此文件为 .env 并修改相应配置

# 环境设置
ENVIRONMENT=development
DEBUG=false
NODE_ID=node-1
NODE_NAME=Metric Scheduler Node

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=metric_scheduler
DB_CHARSET=utf8mb4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# 调度器配置
SCHEDULER_ENABLED=true
SCHEDULER_SCAN_INTERVAL=10
SCHEDULER_MAX_CONCURRENT_TASKS=100
SCHEDULER_TASK_TIMEOUT=300
SCHEDULER_RETRY_COUNT=3
SCHEDULER_QUEUE_BATCH_SIZE=50
SCHEDULER_WORKER_HEARTBEAT_INTERVAL=30
SCHEDULER_WORKER_TIMEOUT=120

# 执行器配置
EXECUTOR_MAX_WORKERS=10
EXECUTOR_DEFAULT_TIMEOUT=300
EXECUTOR_MAX_RETRY_COUNT=3
EXECUTOR_RESULT_CACHE_TTL=3600

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | {message}
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_DIR=logs

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=your-secret-key-change-this
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 监控配置
MONITOR_ENABLED=true
MONITOR_METRICS_PORT=9090
MONITOR_HEALTH_CHECK_INTERVAL=60