# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=metrics_user
DB_PASSWORD=your_secure_password
DB_DATABASE=metrics
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting Configuration
RATE_LIMIT_QPS=100          # Max queries per second
RATE_LIMIT_QPM=5000         # Max queries per minute
RATE_LIMIT_CONCURRENT=50    # Max concurrent queries

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_WORKERS=10

# Monitoring Configuration
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO

# Environment
ENV=development