{
  "name": "robot-call-center",
  "version": "1.0.0",
  "description": "Robot outbound calling system with real-time interaction and human takeover",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "start": "node server/index.js",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "twilio": "^4.19.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.2",
    "@google-cloud/speech": "^6.0.2",
    "winston": "^3.11.0",
    "redis": "^4.6.10",
    "bull": "^4.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}